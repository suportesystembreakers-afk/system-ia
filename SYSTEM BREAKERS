<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SYSTEM BREAKERS IA</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            min-height: 100vh;
            background: #05070d;
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .container {
            width: 92%;
            max-width: 900px;
            text-align: center;
        }

        .logo {
            font-size: 42px;
            font-weight: bold;
            color: #00aaff;
            text-shadow: 0 0 20px #008cff;
            margin-bottom: 10px;
        }

        .subtitle {
            color: #9aa7b5;
            margin-bottom: 35px;
        }

        .card {
            background: #0b101a;
            border: 1px solid #123b5c;
            border-radius: 20px;
            padding: 25px;
            box-shadow: 0 0 35px rgba(0, 140, 255, 0.15);
        }

        .status {
            display: inline-block;
            background: #092719;
            color: #00ff88;
            padding: 8px 15px;
            border-radius: 20px;
            margin-bottom: 25px;
            font-size: 14px;
        }

        .chat {
            min-height: 180px;
            background: #060912;
            border-radius: 15px;
            padding: 20px;
            text-align: left;
            margin-bottom: 20px;
            border: 1px solid #162334;
        }

        .message {
            color: #cbd5e1;
            line-height: 1.6;
        }

        .input-area {
            display: flex;
            gap: 10px;
        }

        input {
            flex: 1;
            padding: 15px;
            border-radius: 12px;
            border: 1px solid #1b496e;
            background: #05070d;
            color: white;
            outline: none;
        }

        input:focus {
            border-color: #00aaff;
            box-shadow: 0 0 10px rgba(0, 170, 255, 0.3);
        }

        button {
            padding: 15px 22px;
            border: none;
            border-radius: 12px;
            background: #008cff;
            color: white;
            font-weight: bold;
            cursor: pointer;
        }

        button:hover {
            background: #00aaff;
        }

        .footer {
            margin-top: 25px;
            color: #667085;
            font-size: 13px;
        }

        @media (max-width: 600px) {
            .logo {
                font-size: 30px;
            }

            .input-area {
                flex-direction: column;
            }

            button {
                width: 100%;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <div class="logo">
            🤖 SYSTEM BREAKERS IA
        </div>

        <div class="subtitle">
            Inteligência artificial para programação e desenvolvimento
        </div>

        <div class="card">

            <div class="status">
                ● SISTEMA ONLINE
            </div>

            <div class="chat" id="chat">
                <div class="message">
                    🤖 Olá! Eu sou a SYSTEM BREAKERS IA.<br><br>
                    Digite uma mensagem abaixo para testar o sistema.
                </div>
            </div>

            <div class="input-area">
                <input
                    type="text"
                    id="message"
                    placeholder="Digite sua mensagem..."
                >

                <button onclick="enviarMensagem()">
                    ENVIAR
                </button>
            </div>

        </div>

        <div class="footer">
            SYSTEM BREAKERS © 2026
        </div>

    </div>

    <script>
        function enviarMensagem() {

            const input = document.getElementById("message");
            const chat = document.getElementById("chat");

            const mensagem = input.value.trim();

            if (!mensagem) {
                return;
            }

            chat.innerHTML += `
                <div class="message" style="margin-top:15px;">
                    👤 <b>Você:</b> ${mensagem}
                </div>
            `;

            chat.innerHTML += `
                <div class="message" style="margin-top:15px; color:#00aaff;">
                    🤖 <b>SYSTEM BREAKERS IA:</b><br>
                    Recebi sua mensagem! A conexão com a inteligência artificial será adicionada na próxima etapa.
                </div>
            `;

            input.value = "";

            chat.scrollTop = chat.scrollHeight;
        }

        document.getElementById("message").addEventListener("keypress", function(event) {
            if (event.key === "Enter") {
                enviarMensagem();
            }
        });
    </script>

</body>
</html>
